<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_height_measure"
        android:largeHeap="true"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_height_measure_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.HeightMeasurement">

        <activity
            android:name=".PerspectiveCorrectionActivity"
            android:exported="false" />

        <activity
            android:name=".PerspectiveSourceActivity"
            android:exported="false" />

        <activity
            android:name=".CameraDistanceActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ImagePreviewActivity"
            android:exported="false" />

        <activity
            android:name=".FileListActivity"
            android:exported="false" />

        <activity
            android:name=".MediaPipeActivity"
            android:exported="false" />

        <activity
            android:name=".MeasurementActivity"
            android:exported="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">

            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />

        </provider>

    </application>

</manifest>
