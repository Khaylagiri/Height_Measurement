<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootMediaPipe"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#000000">

        <ImageView
            android:id="@+id/imageViewMediaPipe"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:adjustViewBounds="true"
            android:contentDescription="Preview MediaPipe"
            android:scaleType="fitCenter" />

    </FrameLayout>

    <LinearLayout
        android:id="@+id/panelMediaPipe"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#000000"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">

        <Button
            android:id="@+id/btnPickMediaPipeImage"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Pilih Foto"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnProcessMediaPipe"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="10dp"
            android:text="Proses MediaPipe"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnSaveMediaPipe"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="10dp"
            android:text="Simpan ke File"
            android:textSize="18sp"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>