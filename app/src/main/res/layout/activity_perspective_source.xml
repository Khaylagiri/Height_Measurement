<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/perspectiveSourceRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#DFF1FF"
    android:fillViewport="true"
    tools:context=".PerspectiveSourceActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:paddingHorizontal="8dp"
            android:text="← Kembali"
            android:textColor="#4338CA"
            android:textSize="16sp"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="24dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp">

                <ImageView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:contentDescription="Perspective Correction"
                    android:src="@android:drawable/ic_menu_crop"
                    app:tint="#6D46D6" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center"
                    android:text="Perspective Correction"
                    android:textColor="#1F2937"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="Pilih sumber gambar yang ingin dikoreksi"
                    android:textColor="#6B7280"
                    android:textSize="15sp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:id="@+id/btnRealTimeCamera"
            android:layout_width="match_parent"
            android:layout_height="132dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_action_button"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="18dp">

            <ImageView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:contentDescription="Kamera Real Time"
                android:src="@android:drawable/ic_menu_camera"
                app:tint="#FFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Kamera Real Time"
                android:textColor="#FFFFFF"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="Ambil gambar langsung menggunakan kamera"
                android:textColor="#EDE9FE"
                android:textSize="14sp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnGallery"
            android:layout_width="match_parent"
            android:layout_height="132dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_action_button"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="18dp">

            <ImageView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:contentDescription="Galeri"
                android:src="@android:drawable/ic_menu_gallery"
                app:tint="#FFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Galeri"
                android:textColor="#FFFFFF"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="Pilih gambar yang sudah tersimpan"
                android:textColor="#EDE9FE"
                android:textSize="14sp" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
