<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/imageViewMeasurement"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:adjustViewBounds="true"
        android:contentDescription="Measurement Preview"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@+id/tvMeasurementResult"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#111827"
        android:gravity="center"
        android:padding="14dp"
        android:text="Siap memproses tinggi badan"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#000000"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="16dp">

        <Button
            android:id="@+id/btnProcessMeasurement"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Proses Tinggi" />

        <Button
            android:id="@+id/btnSaveMeasurement"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="Simpan" />

    </LinearLayout>

</LinearLayout>